{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Plugin-Frontebd Build",
      "type": "shell",
      "command": "./finalize-dist.sh",
      "args": [
        "build"
      ],
      "options": {
        "env": {
          "PLUGIN_PATH": "${fileDirname}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "presentation": {
        "clear": true,
        "close": true,
        "showReuseMessage": false,
        "revealProblems": "onProblem"
      }
    },
    {
      "label": "Plugin-Frontebd Dev",
      "type": "shell",
      "command": "./finalize-dist.sh",
      "args": [
        "dev"
      ],
      "options": {
        "env": {
          "PLUGIN_PATH": "${fileDirname}"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
